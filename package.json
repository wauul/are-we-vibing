    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.5.8",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.3",
